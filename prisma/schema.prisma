generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GigCalendar {
  gigs
  holds
}

enum GigStatus {
  job
  hold
}

model Gig {
  id           String      @id @default(cuid())
  /// The calendar event's UID. It stays the same when a hold is moved into Gigs.
  uid          String      @unique
  rawTitle     String
  calendar     GigCalendar
  /// Decided by which calendar the event is in, not by the title.
  status       GigStatus
  /// The keyword the title used (null if none). A mismatch with status goes to "Needs attention".
  titleKeyword GigStatus?
  person       String?
  /// Lowercase, whitespace-collapsed person, used for grouping.
  personKey    String?
  /// Whole dollars. Null means no price was entered.
  price        Int?
  location     String?
  locationKey  String?
  /// The all-day DTSTART (for a timed event, its day in APP_TIMEZONE).
  gigDate      DateTime    @db.Date
  /// When he first put it in his calendar: the event's CREATED timestamp, kept at its
  /// earliest if a move resets it. Without CREATED, the first sync that saw it, except
  /// for events loaded by the very first sync, which stay null.
  bookedAt     DateTime?
  /// gigDate − bookedAt in days (APP_TIMEZONE). Null when bookedAt is unknown.
  leadDays     Int?
  /// When it became a hold: bookedAt for a new hold, or the sync that saw a job moved to holds.
  heldAt       DateTime?
  /// When a hold was moved into Gigs: its LAST-MODIFIED if that's since the previous sync,
  /// otherwise the sync that saw the move. Cleared if it goes back to holds.
  confirmedAt  DateTime?
  /// Set when the title couldn't be parsed. Shown in "Needs attention".
  parseError   String?
  /// The event has an RRULE. Only its first date is used, and it's flagged.
  recurring    Boolean     @default(false)
  /// The event disappeared from both calendars. Left out of stats, except that a
  /// deleted hold counts as one that fell through.
  deletedAt    DateTime?
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SyncRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  /// Null while the run is in progress, or if it crashed.
  finishedAt     DateTime?
  ok             Boolean   @default(false)
  message        String?
  fetched        Int       @default(0)
  created        Int       @default(0)
  updated        Int       @default(0)
  deleted        Int       @default(0)
  /// Fetched events without a CREATED timestamp, i.e. with no booking date from Apple.
  missingCreated Int       @default(0)
}
