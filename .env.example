# Postgres. On Vercel the Neon integration sets this automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gigdash"

# Apple ID email and an app-specific password (account.apple.com → Sign-In and Security).
ICLOUD_EMAIL=""
ICLOUD_APP_PASSWORD=""

# Display names of the two calendars to read. Nothing else is fetched.
GIGS_CALENDAR="Gigs"
HOLDS_CALENDAR=""

# Encrypts the iCloud passwords people save. Make one with: openssl rand -base64 32
# To replace it later, add CREDENTIALS_KEY_2; values saved under the old key still read.
CREDENTIALS_KEY=""

# Password for the dashboard login.
DASHBOARD_PASSWORD=""

# Shared secret so only the Vercel cron job can trigger a sync.
CRON_SECRET=""

APP_TIMEZONE="America/New_York"

# Signs session cookies. Any long random text.
BETTER_AUTH_SECRET=""

# Sends sign-in links. Without a key, `next dev` prints them to its log instead.
RESEND_API_KEY=""
EMAIL_FROM="Gigs <login@yourdomain.com>"

# Cloudflare Turnstile, the bot check on the sign-in form. Without both, a deployment won't send
# sign-in links. `next dev` skips the check if neither is set.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
